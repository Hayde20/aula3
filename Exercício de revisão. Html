// exercicio 3

document.getElementById("verificar").onclick = function () {
    let idade = document.getElementById("idade").value;
    let resultado = document.getElementById("resultadoIdade");

    if (idade.trim() === "") {
        resultado.textContent = "Preencha sua idade!";
    } else if (Number(idade) < 0) {
        resultado.textContent = "Idade inválida!";
    } else if (Number(idade) >= 18) {
        resultado.textContent = "Maior de idade!";
    } else {
        resultado.textContent = "Menor de idade!";
    }
};


// exercicio 4

document.getElementById("adicionarNome").onclick = function () {
    let campo = document.getElementById("nome");
    let nome = campo.value.trim();

    if (nome === "") {
        alert("Digite um nome!");
