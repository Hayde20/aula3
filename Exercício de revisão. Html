// exercicio 7 

let notas = [];

document.getElementById("adicionarAluno").onclick = function () {
    let nome = document.getElementById("aluno").value.trim();
    let nota = document.getElementById("nota").value;

    if (nome === "" || nota === "") {
        alert("Preencha todos os campos!");
        return;
    }

    nota = Number(nota);

    if (nota < 0 || nota > 10) {
        alert("Nota inválida!");
        return;
    }

    let situacao = nota >= 6 ? "Aprovado" : "Reprovado";

    notas.push({ nome, nota, situacao });

    atualizarNotas();

    document.getElementById("aluno").value = "";
    document.getElementById("nota").value = "";
};

function atualizarNotas() {
    let lista = document.getElementById("listaAlunos");
    lista.innerHTML = "";

    notas.forEach(function (aluno, index) {
        let item = document.createElement("li");

        item.textContent = aluno.nome + " - Nota: " +
            aluno.nota + " - " + aluno.situacao + " ";

        let excluir = document.createElement("button");
        excluir.textContent = "Excluir";

        excluir.onclick = function () {
            notas.splice(index, 1);
            atualizarNotas();
        };

        item.appendChild(excluir);
        lista.appendChild(item);
    });

    let soma = notas.reduce(function (total, aluno) {
        return total + aluno.nota;
    }, 0);

    let media = notas.length > 0 ? soma / notas.length : 0;

    document.getElementById("mediaNotas").textContent =
        "Média: " + media.toFixed(2);
}


