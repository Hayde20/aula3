// exercicio 9 

let estoque = [];

document.getElementById("cadastrarEstoque").onclick = function () {
    let nome = document.getElementById("nomeEstoque").value.trim();
    let quantidade = document.getElementById("quantidade").value;
    let preco = document.getElementById("preco").value;

    if (nome === "" || quantidade === "" || preco === "") {
        alert("Preencha todos os campos!");
        return;
    }

    quantidade = Number(quantidade);
    preco = Number(preco);

    if (!Number.isInteger(quantidade) || quantidade <= 0 || preco < 0) {
        alert("Informe valores válidos!");
        return;
    }

    estoque.push({ nome, quantidade, preco });

    atualizarEstoque();

    document.getElementById("nomeEstoque").value = "";
    document.getElementById("quantidade").value = "";
    document.getElementById("preco").value = "";
};

function atualizarEstoque() {
    let lista = document.getElementById("listaEstoque");
    lista.innerHTML = "";

    let total = 0;

    estoque.forEach(function (produto, index) {
        let valor = produto.quantidade * produto.preco;
        total += valor;

        let item = document.createElement("li");

        item.textContent = produto.nome +
            " | Quantidade: " + produto.quantidade +
            " | Preço: R$ " + produto.preco.toFixed(2) +
            " | Total: R$ " + valor.toFixed(2) + " ";

        let excluir = document.createElement("button");
        excluir.textContent = "Excluir";

        excluir.onclick = function () {
            estoque.splice(index, 1);
            atualizarEstoque();
        };

        item.appendChild(excluir);
        lista.appendChild(item);
    });

    document.getElementById("valorTotal").textContent =
        "Valor total do estoque: R$ " + total.toFixed(2);
}


// exercicio 10 

let tarefas = [];

document.getElementById("adicionarTarefa").onclick = function () {
    let descricao = document.getElementById("descricaoTarefa").value.trim();

    if (descricao === "") {
        alert("Digite uma tarefa!");
        return;
    }

    tarefas.push({
        descricao: descricao,
        concluida: false
    });

    atualizarTarefas();

    document.getElementById("descricaoTarefa").value = "";
};

function atualizarTarefas() {
    let lista = document.getElementById("listaTarefas");
    lista.innerHTML = "";

    tarefas.forEach(function (tarefa, index) {
        let item = document.createElement("li");

        item.textContent = tarefa.descricao +
            (tarefa.concluida ? " - Concluída " : " - Pendente ");

        if (tarefa.concluida) {
            item.style.textDecoration = "line-through";
        }

        let concluir = document.createElement("button");
        concluir.textContent = "Concluir";

        concluir.onclick = function () {
            tarefa.concluida = !tarefa.concluida;
            atualizarTarefas();
        };

        let excluir = document.createElement("button");
        excluir.textContent = "Excluir";

        excluir.onclick = function () {
            tarefas.splice(index, 1);
            atualizarTarefas();
        };

        item.appendChild(concluir);
        item.appendChild(excluir);

        lista.appendChild(item);
    });

    let concluidas = tarefas.filter(function (t) {
        return t.concluida;
    }).length;

    let pendentes = tarefas.length - concluidas;

    document.getElementById("totalTarefas").textContent =
        "Total de tarefas: " + tarefas.length;

    document.getElementById("tarefasConcluidas").textContent =
        "Concluídas: " + concluidas;

    document.getElementById("tarefasPendentes").textContent =
        "Pendentes: " + pendentes;
}
