};


// exercicio 5

document.getElementById("adicionarProduto").onclick = function () {
    let campo = document.getElementById("produto");
    let nome = campo.value.trim();

    if (nome === "") {
        alert("Digite um produto!");
        return;
    }

    let item = document.createElement("li");
    let texto = document.createElement("span");

    texto.textContent = nome + " ";

    let comprado = document.createElement("button");
    comprado.textContent = "Comprado";

    comprado.onclick = function () {
        texto.style.textDecoration = "line-through";
        texto.style.color = "green";
        texto.textContent = nome + " - Comprado ";
    };

    let excluir = document.createElement("button");
    excluir.textContent = "Excluir";

    excluir.onclick = function () {
        item.remove();
    };

    item.appendChild(texto);
    item.appendChild(comprado);
    item.appendChild(excluir);

    document.getElementById("listaCompras").appendChild(item);

    campo.value = "";
};
